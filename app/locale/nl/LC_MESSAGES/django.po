#: templates/account/login.html:15
#, python-format
msgid ""
"Please sign in with one of your existing third party accounts. Or, <a href="
"\"%(signup_url)s\" class=\"text-blue-600 hover:underline font-semibold"
"\">sign up</a> for a %(site_name)s account and sign in below:"
