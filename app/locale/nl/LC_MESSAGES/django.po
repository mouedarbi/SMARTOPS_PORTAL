msgid "Password Reset"
msgstr "Wachtwoord herstellen"

#: templates/account/password_reset.html:16
msgid ""
"Forgotten your password? Enter your e-mail address below, and we'll send you "
"an e-mail allowing you to reset it."
msgstr "Wachtwoord vergeten? Voer hieronder uw e-mailadres in en we sturen u een e-mail waarmee u het kunt herstellen."

#: templates/account/password_reset.html:23
msgid "Reset My Password"
msgstr "Mijn wachtwoord herstellen"

#: templates/account/password_reset.html:28
msgid "Please contact us if you have any trouble resetting your password."
msgstr "Neem contact met ons op als u problemen ondervindt bij het herstellen van uw wachtwoord."

#: templates/account/password_reset_done.html:18
msgid ""
"We have sent you an e-mail. Please contact us if you do not receive it "
"within a few minutes."
msgstr "We hebben u een e-mail gestuurd. Neem contact met ons op als u deze niet binnen enkele minuten ontvangt."

