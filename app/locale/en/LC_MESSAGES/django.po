#, python-format
msgid "Votre compte a été désactivé. Vos données personnelles seront définitivement anonymisées dans un délai de %(days)s jours."
msgstr "Your account has been deactivated. Your personal data will be permanently anonymized within %(days)s days."

msgid "Votre compte sera désactivé immédiatement."
msgstr "Your account will be deactivated immediately."

#, python-format
msgid "Votre nom, adresse e-mail et mot de passe seront définitivement anonymisés dans un délai de %(days)s jours."
msgstr "Your name, email address and password will be permanently anonymized within %(days)s days."

msgid "Support · rétractation"
msgstr "Support · withdrawal"

msgid "Licence jamais activée"
msgstr "License never activated"

msgid "Licence sans renonciation à la rétractation"
msgstr "License without waiver of withdrawal"

